# 【选填】主文本模型名称
# 默认值: qwen3-max
TEXT_MODEL_NAME=qwen3-max

# 【选填】图像模型名称 (Edit版)
# 默认值: qwen-image-max
IMAGE_MODEL_EDIT=qwen-image-edit-plus

# 【选填】图像模型名称 (Plus版)
# 默认值: qwen-image-plus
IMAGE_MODEL_PLUS=qwen-image-plus

# redis环境
$env:SESSION_STORE="redis"

$env:REDIS_HOST=""
$env:REDIS_PORT="6379"
$env:REDIS_USERNAME=""
$env:REDIS_PASSWORD=""
$env:REDIS_DB="0"
$env:REDIS_SSL="false"

$env:REDIS_KEY_PREFIX="product-recommend:post"
$env:SESSION_TTL_SECONDS="1800"

$env:REDIS_LOCK_TTL_SECONDS="60"
$env:REDIS_LOCK_WAIT_SECONDS="10"
$env:REDIS_LOCK_RETRY_SECONDS="0.05"

# mysql环境
$env:LOG_MYSQL_HOST=""
$env:LOG_MYSQL_PORT="3306"
$env:LOG_MYSQL_USER=""
$env:LOG_MYSQL_PASSWORD=""
$env:LOG_MYSQL_DATABASE="product_recommend_test"
$env:LOG_MYSQL_SSL="false"

$env:FEEDBACK_MYSQL_HOST=""
$env:FEEDBACK_MYSQL_PORT="3306"
$env:FEEDBACK_MYSQL_USER=""
$env:FEEDBACK_MYSQL_PASSWORD=""
$env:FEEDBACK_MYSQL_DATABASE="product_recommend_test"
$env:FEEDBACK_MYSQL_SSL="false"

## 安全模型检测
$env:ALIYUN_GUARD_ACCESS_KEY_ID=""
$env:ALIYUN_GUARD_ACCESS_KEY_SECRET=""